#!/usr/bin/python3
"""Lanceur de ScreenPort."""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _candidate in (os.path.join(_here, ".."), "/usr/lib/screenport"):
    if os.path.isfile(os.path.join(_candidate, "screenport", "application.py")):
        sys.path.insert(0, os.path.abspath(_candidate))
        break

from screenport.application import main  # noqa: E402

sys.exit(main(sys.argv))
